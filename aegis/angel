#!/bin/bash
# ANGEL Doctor - System Compatibility Checker
# Usage: ./aegis/angel doctor

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

PASS=0
FAIL=0
WARN=0

check() {
    local name="$1"
    local cmd="$2"
    local required="$3"
    
    if eval "$cmd" >/dev/null 2>&1; then
        echo -e "  ${GREEN}✓${NC} $name"
        PASS=$((PASS + 1))
    else
        if [ "$required" = "yes" ]; then
            echo -e "  ${RED}✗${NC} $name (REQUIRED)"
            FAIL=$((FAIL + 1))
        else
            echo -e "  ${YELLOW}⚠${NC} $name (optional)"
            WARN=$((WARN + 1))
        fi
    fi
}

echo "=========================================="
echo "  ANGEL Doctor - System Check"
echo "=========================================="
echo ""

echo "--- OS ---"
echo "  OS: $(cat /etc/os-release 2>/dev/null | grep PRETTY_NAME | cut -d'"' -f2 || echo 'Unknown')"
echo "  Arch: $(uname -m)"
echo "  Kernel: $(uname -r)"
echo ""

echo "--- Mandatory Dependencies ---"
check "Go" "go version" "yes"
check "curl" "which curl" "yes"
check "git" "which git" "yes"
check "make" "which make" "yes"
echo ""

echo "--- Optional Dependencies ---"
check "nmap" "which nmap" "no"
check "netcat" "which nc" "no"
check "python3" "which python3" "no"
check "iptables" "which iptables" "no"
echo ""

echo "--- Docker ---"
check "Docker" "docker --version" "no"
check "Docker Compose" "docker compose version" "no"
echo ""

echo "--- Build Test ---"
if CGO_ENABLED=0 go build -o /tmp/angel-test ./cmd/teamserver 2>/dev/null; then
    echo -e "  ${GREEN}✓${NC} CGO_ENABLED=0 build OK"
    PASS=$((PASS + 1))
    rm -f /tmp/angel-test
else
    echo -e "  ${RED}✗${NC} CGO_ENABLED=0 build FAILED"
    FAIL=$((FAIL + 1))
fi
echo ""

echo "--- Environment Variables ---"
[ -n "$TEAMSERVER_KEY" ] && echo -e "  ${GREEN}✓${NC} TEAMSERVER_KEY set" || echo -e "  ${YELLOW}⚠${NC} TEAMSERVER_KEY not set"
[ -n "$CRYPTO_KEY" ] && echo -e "  ${GREEN}✓${NC} CRYPTO_KEY set" || echo -e "  ${YELLOW}⚠${NC} CRYPTO_KEY not set"
[ -n "$JWT_SECRET" ] && echo -e "  ${GREEN}✓${NC} JWT_SECRET set" || echo -e "  ${YELLOW}⚠${NC} JWT_SECRET not set"
echo ""

echo "--- Disk Space ---"
df -h / | tail -1 | awk '{print "  Available: " $4}'
echo ""

echo "--- Memory ---"
free -h | grep Mem | awk '{print "  Total: " $2 ", Available: " $3}'
echo ""

echo "=========================================="
echo "  Results: $PASS PASS, $FAIL FAIL, $WARN WARN"
echo "=========================================="

if [ "$FAIL" -gt 0 ]; then
    echo -e "  ${RED}System NOT ready for ANGEL${NC}"
    exit 1
else
    echo -e "  ${GREEN}System ready for ANGEL${NC}"
    exit 0
fi