# ANGEL Platform Configuration
#
# INSTRUKSI: Copy file ini ke .env dan isi dengan nilai acak 32+ karakter.
# JANGAN pernah commit .env ke repository.
# Cara generate: openssl rand -base64 32
#
# Contoh:
#   export TEAMSERVER_KEY="$(openssl rand -base64 32)"
#   export CRYPTO_KEY="$(openssl rand -base64 32)"
#   export JWT_SECRET="$(openssl rand -base64 32)"

# Supabase Configuration (opsional, untuk production)
# export SUPABASE_URL=https://angel.supabase.co
# export SUPABASE_ANON_KEY=ANGEL-ANON-REPLACE-WITH-REAL-KEY
# export SUPABASE_SERVICE_ROLE_KEY=ANGEL-SRV-REPLACE-WITH-REAL-KEY

# Teamserver Configuration (WAJIB - panic jika tidak di-set)
export TEAMSERVER_KEY=
export CRYPTO_KEY=

# API Gateway Configuration (WAJIB - fatal jika tidak di-set)
export JWT_SECRET=

# Database Configuration
export DATABASE_URL=sqlite:///data/angel.db
export DATABASE_ENCRYPTION_KEY=

# C2 Configuration
export C2_DEFAULT_PROFILE=teams
export C2_DEFAULT_SLEEP=30s
export C2_DEFAULT_JITTER=0.25
export C2_MAX_AGENTS=1000

# Listener Configuration
export LISTENER_HTTPS_PORT=443
export LISTENER_DNS_PORT=53
export LISTENER_SMB_PORT=445
export LISTENER_WEBSOCKET_PORT=8443

# Encryption Configuration
export ENCRYPTION_ALGORITHM=aes-256-gcm
export ENCRYPTION_KEY_ROTATION=24h

# Logging Configuration
export LOG_LEVEL=info
export LOG_FILE=/var/log/angel/angel.log
export LOG_MAX_SIZE=100MB
export LOG_MAX_BACKUPS=7

# API Gateway Configuration
export API_GATEWAY_ADDR=0.0.0.0
export API_GATEWAY_PORT=3000
export API_GATEWAY_SECRET=

# Frontend Configuration
export FRONTEND_URL=http://localhost:4200
export FRONTEND_API_URL=http://localhost:3000

# Infrastructure Configuration
export INFRA_PROVIDER=aws
export INFRA_REGION=us-east-1
export INFRA_VPC_CIDR=10.0.0.0/16

# Security Configuration
export SECURITY_ENABLE_MFA=true
export SECURITY_SESSION_TIMEOUT=30m
export SECURITY_MAX_LOGIN_ATTEMPTS=5
export SECURITY_LOCKOUT_DURATION=15m

# Notification Configuration
export NOTIFICATION_EMAIL_ENABLED=false
export NOTIFICATION_SMTP_HOST=smtp.angel.local
export NOTIFICATION_SMTP_PORT=587
export NOTIFICATION_EMAIL_FROM=noreply@angel.local

# RPG Configuration (for gamification)
export RPG_EXPERIENCE_PER_TASK=100
export RPG_LEVEL_UP_THRESHOLD=1000
export RPG_ENABLE_ACHIEVEMENTS=true

# Purchase Configuration (for in-app purchases)
export PURCHASE_IOS_BUNDLE_ID=com.angel.platform
export PURCHASE_STRIPE_KEY=
export PURCHASE_WEBHOOK_SECRET=
