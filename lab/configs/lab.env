# ANGEL Platform LAB Environment Configuration
# Generated: 2026-09-18 00:00:00 UTC
#
# ENV PERINGATAN: Ini adalah config LAB/DEV.
# Untuk production, gunakan .env dengan nilai acak 32+ karakter.
# Generate: openssl rand -base64 32

TEAMSERVER_ADDR=0.0.0.0
TEAMSERVER_PORT=8080
TEAMSERVER_KEY=

DATABASE_URL=sqlite:///lab/data/angel.db
DATABASE_ENCRYPTION_KEY=

C2_DEFAULT_PROFILE=teams
C2_DEFAULT_SLEEP=30s
C2_DEFAULT_JITTER=0.25
C2_MAX_AGENTS=100

LISTENER_HTTPS_PORT=8443
LISTENER_DNS_PORT=5353
LISTENER_SMB_PORT=4455
LISTENER_WEBSOCKET_PORT=9443

ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY_ROTATION=24h

LOG_LEVEL=debug
LOG_FILE=lab/logs/angel.log
LOG_MAX_SIZE=50MB
LOG_MAX_BACKUPS=5

API_GATEWAY_ADDR=0.0.0.0
API_GATEWAY_PORT=3000
API_GATEWAY_SECRET=

FRONTEND_URL=http://localhost:4200
FRONTEND_API_URL=http://localhost:8080

INFRA_PROVIDER=local
INFRA_REGION=lab
INFRA_VPC_CIDR=10.0.0.0/16
JWT_SECRET=

# Supabase (opsional - set untuk production)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
